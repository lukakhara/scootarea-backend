generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id              String     @id @default(uuid())
  firstName       String
  lastName        String
  email           String     @unique
  password        String
  phone           String?
  role            Role       @default(USER)
  isVerified      Boolean    @default(false)
  isBanned        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  termsAcceptedAt DateTime
  termsVersion    String
  blogPosts       BlogPost[]
  orders          Order[]
  addresses       Address[]
}
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
model Scooter {
  id                     String      @id @default(uuid())
  name                   String      @unique
  brand                  String
  price                  Decimal     @db.Decimal(10, 2)
  engine                 String
  maxSpeed               Int
  maxRange               Int
  weight                 Float
  releaseDate            DateTime
  warranty               String
  inclineAngle           String
  chargingTime           String
  maxRiderWeight         Int
  recommendedRiderWeight Int
  motorCount             Int
  wheelSize              String
  driveType              String
  battery                String
  suspension             String
  antiSlipSystem         Boolean
  brakeType              String
  connectivity           String
  ipRating               String
  stock                  Int         @default(0)
  images                 String[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @default(now()) @updatedAt
  discountEndsAt         DateTime?
  discountPrice          Decimal?    @db.Decimal(10, 2)
  orderItems             OrderItem[]
  spareParts             SparePart[] @relation("ScooterSpareParts")
}
model Accessory {
  id             String                 @id @default(uuid())
  brand          String
  size           String?
  sex            Gender
  category       AccessoryCategory
  price          Decimal                @db.Decimal(10, 2)
  stock          Int                    @default(0)
  images         String[]
  compatibleWith String[]
  createdAt      DateTime               @default(now())
  discountEndsAt DateTime?
  discountPrice  Decimal?               @db.Decimal(10, 2)
  updatedAt      DateTime               @default(now()) @updatedAt
  translations   AccessoryTranslation[]
  orderItems     OrderItem[]
}

model AccessoryTranslation {
  id          String    @id @default(uuid())
  accessoryId String
  locale      String
  name        String
  description String?
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@unique([accessoryId, locale])
  @@index([locale, name])
}

enum AccessoryCategory {
  SAFETY_GEAR
  PROTECTION_MAINTENANCE
  STORAGE_CARRYING
  LIGHTING
  COMFORT_UPGRADES
  CHARGING_POWER
  SPARE_PARTS
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

model SparePart {
  id               String                 @id @default(uuid())
  sku              String                 @unique
  category         SparePartCategory
  price            Decimal                @db.Decimal(10, 2)
  stock            Int                    @default(0)
  images           String[]
  material         String?
  weight           Float?
  color            String?
  manufacturer     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @default(now()) @updatedAt
  discountEndsAt   DateTime?
  discountPrice    Decimal?               @db.Decimal(10, 2)
  orderItems       OrderItem[]
  translations     SparePartTranslation[]
  compatibleModels Scooter[]              @relation("ScooterSpareParts")
}

model SparePartTranslation {
  id          String    @id @default(uuid())
  sparePartId String
  locale      String
  name        String
  description String?
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, locale])
  @@index([locale])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum SparePartCategory {
  BRAKE_PADS
  TIRES_TUBES
  MOTOR_PARTS
  BATTERY_CELLS
  WHEELS
  BEARINGS
  CABLES_WIRING
  CONTROLLER
  DISPLAY_PANEL
  SUSPENSION_PARTS
  SCREWS_BOLTS
  OTHER
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String
  excerpt     String?
  content     String
  coverImage  String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      String[]  @default([])
  locale      String
  published   Boolean   @default(false)
  videoUrl    String?
  author      User      @relation(fields: [authorId], references: [id])

  @@unique([slug, locale])
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  customerName  String
  customerEmail String
  customerPhone String
  city          String
  street        String
  postalCode    String
  country       String     @default("Georgia")
  totalPrice    Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]


  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  scooterId    String?
  accessoryId  String?
  sparePartId  String?
  // snapshot at purchase time, so later edits to the product don't change old orders
  productName  String
  productImage String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scooter   Scooter?   @relation(fields: [scooterId], references: [id], onDelete: Restrict)
  accessory Accessory? @relation(fields: [accessoryId], references: [id], onDelete: Restrict)
  sparePart SparePart? @relation(fields: [sparePartId], references: [id], onDelete: Restrict)

  // one line per product per order (also indexes orderId)
  @@unique([orderId, scooterId])
  @@unique([orderId, accessoryId])
  @@unique([orderId, sparePartId])
  @@index([scooterId])
  @@index([accessoryId])
  @@index([sparePartId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       String
  street     String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
